{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "description": "一個作品（content/projects/<id>.json）。新增後記得在 data/projects-list.ts 登記。中文寫在 content/i18n/projects.zh.json。",
  "type": "object",
  "required": ["id", "title", "subtitle", "description", "category", "themes", "tier", "status", "timeline", "role"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9.-]+$", "description": "網址用的代號：/projects/<id>/，要跟檔名一樣。" },
    "title": { "type": "string" },
    "subtitle": { "type": "string", "description": "一句話說它是什麼，例如 Image Format Converter。" },
    "description": { "type": "string", "description": "卡片上的一兩句介紹。可以自嘲，但事實要對。" },
    "longDescription": { "type": "string", "description": "作品頁的概要段落。" },
    "language": { "type": "string" },
    "images": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(https?://|/)" },
      "description": "截圖：外部網址，或放在 public/ 底下的站內路徑（例如 /images/projects/<id>/1.webp，給不能公開的 repo 用）。第一張是作品頁主圖，也是卡片縮圖的來源（node scripts/make-thumbs.mjs）。"
    },
    "githubUrl": { "type": "string", "format": "uri" },
    "category": {
      "enum": ["AI/ML", "Web Development", "Data Science", "Computer Vision", "Backend", "DevOps", "Medical Imaging", "Utilities", "Browser Extension", "Image Processing", "Data Collection", "API/SDK", "Web Application", "Web Automation", "Productivity Tools"]
    },
    "themes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "所屬分類，第一個是主分類。可用的 id 和名稱只寫在 content/project-themes.json（npm test 會檢查）。別人用某個分類篩選時會預期看到這個作品，才加上那個分類。"
    },
    "tier": { "enum": ["flagship", "selected", "archive"], "description": "flagship 只給 Telepy；selected 會出現在卡片區（首頁取前 6 個）；archive 在列表。" },
    "status": { "enum": ["Completed", "In Progress", "Archived"] },
    "opensource": { "type": "boolean" },
    "technologies": { "type": "array", "items": { "type": "string" } },
    "features": { "type": "array", "items": { "type": "string" } },
    "challenges": { "type": "array", "items": { "type": "string" } },
    "solutions": { "type": "array", "items": { "type": "string" } },
    "results": { "type": "array", "items": { "type": "string" } },
    "why": { "type": "string", "description": "為什麼做這個作品，一到三句。語氣和介紹一樣，可以自嘲，但事實要對。中文寫在 content/i18n/projects.zh.json 的 why。" },
    "architecture": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "description": "簡單的架構圖：一層一層由左到右，每層一個節點，或 2–3 個並排的節點（nodes）。相鄰兩層預設全部互連，要例外就用 to。整張圖只有一個 core: true（這個作品本身，可以是一個節點或整層）。最後一層不寫 next。中文照同樣的層與節點順序寫在 projects.zh.json 的 architecture，只寫 title、items、next。",
      "items": {
        "type": "object",
        "required": ["title", "items"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "items": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
          "next": { "type": "string", "description": "往下一層的箭頭上寫的字。" },
          "core": { "const": true },
          "kind": { "type": "string", "description": "節點種類，決定圖示。可用的值寫在 lib/content/contract.ts 的 ArchitectureKind（npm test 會檢查）。" },
          "id": { "type": "string", "description": "只有一個節點時的 id，給上一層的 to 用。" },
          "to": { "type": "array", "items": { "type": "string" }, "description": "只連到下一層的哪幾個節點（填 id）。沒寫就和下一層全部互連。" },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "description": "這一層並排的節點；有 nodes 時，title 是這一層的標題，items 留空。",
            "items": {
              "type": "object",
              "required": ["id", "title", "items"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "items": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
                "kind": { "type": "string", "description": "節點種類，決定圖示。可用的值寫在 lib/content/contract.ts 的 ArchitectureKind（npm test 會檢查）。" },
                "core": { "const": true },
                "to": { "type": "array", "items": { "type": "string" }, "description": "只連到下一層的哪幾個節點（填 id）。沒寫就和下一層全部互連。" }
              }
            }
          }
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "github": { "type": "string", "format": "uri" },
        "demo": { "type": "string", "format": "uri" },
        "pypi": { "type": "string", "format": "uri" },
        "documentation": { "type": "string", "format": "uri" },
        "article": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": ["start"],
      "properties": {
        "start": { "type": "string", "description": "YYYY 或 YYYY-MM" },
        "end": { "type": "string", "description": "YYYY-MM 或 Present" },
        "duration": { "type": "string" }
      }
    },
    "role": { "type": "string" },
    "company": { "type": "string" },
    "team": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
