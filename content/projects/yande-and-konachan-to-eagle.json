{
  "$schema": "../schema/project.schema.json",
  "id": "yande-and-konachan-to-eagle",
  "title": "Yande & Konachan to Eagle",
  "subtitle": "Find images. Keep the tags. Send to Eagle.",
  "description": "A pipx-installable CLI using the sites’ JSON APIs and EagleWrapper. Preview with --dry-run, keep your own tags and skip items already imported.",
  "longDescription": "A command-line importer for yande.re and konachan.com that sends image URLs and metadata to Eagle. The 2026 version uses JSON APIs, EagleWrapper and resumable state, with configurable searches, item limits, folders and a dry-run preview.",
  "language": "python",
  "mascotLines": [
    "Add rating:s to the search and it's safe to open at work.",
    "Eagle does the downloading. This tool just hands it the list."
  ],
  "images": [
    "/images/projects/yande-and-konachan-to-eagle/cover.webp"
  ],
  "githubUrl": "https://github.com/NatLee/yande-and-konachan-to-eagle",
  "category": "Utilities",
  "themes": [
    "libraries"
  ],
  "tier": "archive",
  "status": "Completed",
  "opensource": true,
  "technologies": [
    "Python",
    "JSON APIs",
    "EagleWrapper",
    "pipx"
  ],
  "features": [
    "JSON-API searches with item limits",
    "Custom tags and destination folders",
    "Dry-run preview and duplicate skipping",
    "Resumable progress and pipx installation"
  ],
  "why": "Collecting pictures from yande.re and konachan.com into Eagle by hand means saving each file and retyping its English tags in your own words. This sends each post to Eagle with the tags already mapped and remembers where it stopped. Eagle does the actual downloading; the script just hands it the list.",
  "gains": "Collectors end up with a library already tagged in their own words, and a search like 'beach rating:s' keeps it safe to open at work. It is also the worked example for EagleWrapper: a complete, small downloader to copy when feeding Eagle from some other site.",
  "flow": [
    {
      "id": "load",
      "label": "Load config and tag map",
      "kind": "start",
      "detail": "Both made on the first run"
    },
    {
      "id": "search",
      "label": "Given a --search?",
      "kind": "decision",
      "group": "Which posts",
      "to": [
        {
          "id": "newer",
          "label": "no"
        },
        {
          "id": "query",
          "label": "yes"
        }
      ]
    },
    {
      "id": "newer",
      "label": "Ask for posts after last ID",
      "detail": "Oldest first, from config.ini",
      "group": "Which posts",
      "to": [
        {
          "id": "next"
        }
      ]
    },
    {
      "id": "query",
      "label": "Run the site's own search",
      "detail": "Newest first, any site syntax",
      "group": "Which posts"
    },
    {
      "id": "next",
      "label": "Take the next post",
      "detail": "Pages of 100, a second apart"
    },
    {
      "id": "seen",
      "label": "Already in imported.txt?",
      "kind": "decision",
      "to": [
        {
          "id": "map",
          "label": "no"
        },
        {
          "id": "mark",
          "label": "yes, skip"
        }
      ]
    },
    {
      "id": "map",
      "label": "Swap site tags for yours",
      "detail": "Unmapped tags are left out"
    },
    {
      "id": "send",
      "label": "Hand the image URL to Eagle",
      "detail": "Eagle does the heavy lifting",
      "group": "Eagle's side"
    },
    {
      "id": "accepted",
      "label": "Did Eagle accept it?",
      "kind": "decision",
      "group": "Eagle's side",
      "to": [
        {
          "id": "log",
          "label": "yes"
        },
        {
          "id": "refused",
          "label": "no"
        }
      ]
    },
    {
      "id": "log",
      "label": "Add it to imported.txt",
      "detail": "So it never lands twice",
      "group": "Eagle's side",
      "to": [
        {
          "id": "mark"
        }
      ]
    },
    {
      "id": "refused",
      "label": "Note it as refused",
      "detail": "Retry later with --search id:",
      "group": "Eagle's side"
    },
    {
      "id": "mark",
      "label": "Save the last post ID",
      "detail": "Plain runs, after every post"
    },
    {
      "id": "more",
      "label": "More posts to go?",
      "kind": "decision",
      "detail": "--limit can stop it early",
      "to": [
        {
          "id": "next",
          "label": "yes"
        },
        {
          "id": "done",
          "label": "no"
        }
      ]
    },
    {
      "id": "done",
      "label": "Print the summary",
      "kind": "end",
      "detail": "Refused posts listed last"
    }
  ],
  "lessons": [
    "Reading the JSON API, 100 posts per request, replaced loading one web page per post ID: much faster, and much lighter on the site.",
    "In November 2026 konachan.com's Cloudflare check turned the script away; it now says so in one line and does not try to get around it.",
    "The 2023 version dropped posts Eagle refused without a word; now they are listed at the end, ready to retry with --search id:."
  ],
