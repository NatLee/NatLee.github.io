{
  "$schema": "../schema/project.schema.json",
  "id": "myanimelist-comment-crawler",
  "title": "MyAnimeList Review Crawler",
  "subtitle": "From anime reviews to a resumable dataset",
  "description": "Collect anime details and reviews through a Jikan-style API or permitted MAL pages, save progress in SQLite and export the dataset as CSV.",
  "longDescription": "A Scrapy-based crawler with interchangeable JSON-API and HTML inputs, using the same SQLite tables and CSV output. Sequential requests, retry delays and resume support make long-running collection traceable. The HTML mode follows robots.txt restrictions.",
  "language": "python",
  "mascotLines": [
    "The 2023 export sorted dates as text, so April came before January.",
    "Reviewers score their own reviews, so the labelling was done for me."
  ],
  "images": [
    "/images/projects/myanimelist-comment-crawler/cover.webp"
  ],
  "githubUrl": "https://github.com/NatLee/myanimelist-comment-crawler",
  "category": "Data Collection",
  "themes": [
    "language"
  ],
  "tier": "archive",
  "status": "Completed",
  "opensource": true,
  "technologies": [
    "Python",
    "Scrapy",
    "SQLite",
    "Jikan API"
  ],
  "features": [
    "JSON API and HTML inputs",
    "SQLite progress storage and resumable runs",
    "CSV output matching the MyAnimeList comment dataset",
    "Sequential requests, backoff and robots.txt handling"
  ],
  "why": "Both the day job in public opinion and the master's thesis needed sentiment data, so this crawler turned MyAnimeList reviews into the MALCoD dataset on Kaggle. Reviewers rate what they review, which spares somebody a lot of labelling.",
  "gains": "For research that needs review text in bulk: a crawl of many hours can stop and pick up at the last saved page, the API source stays under the rate limit, and the CSV columns match the 2023 Kaggle datasets, so code written for those keeps working.",
  "flow": [
    {
      "id": "src",
      "label": "Pick a source",
      "kind": "start",
      "detail": "jikan-edge by default"
    },
    {
      "id": "which",
      "label": "Which source?",
      "kind": "decision",
      "group": "Source check",
      "to": [
        {
          "id": "robots",
          "label": "html pages"
        },
        {
          "id": "titles",
          "label": "Jikan-Edge API"
        }
      ]
    },
    {
      "id": "robots",
      "label": "robots.txt lets Scrapy in?",
      "kind": "decision",
      "group": "Source check",
      "to": [
        {
          "id": "titles",
          "label": "yes"
        },
        {
          "id": "refused",
          "label": "no"
        }
      ]
    },
    {
      "id": "refused",
      "label": "Stop and suggest jikan-edge",
      "kind": "end",
      "detail": "MAL disallows Scrapy now",
      "group": "Source check"
    },
    {
      "id": "titles",
      "label": "Save titles from the ranking",
      "detail": "Saved ones skipped next time"
    },
    {
      "id": "pick",
      "label": "Take the next title",
      "detail": "--resume skips finished ones",
      "group": "Review spider loop"
    },
    {
      "id": "page",
      "label": "Fetch the next review page",
      "detail": "One request at a time",
      "group": "Review spider loop"
    },
    {
      "id": "limited",
      "label": "Server says slow down?",
      "kind": "decision",
      "detail": "HTTP 429, 503 and the like",
      "group": "Review spider loop",
      "to": [
        {
          "id": "wait",
          "label": "yes"
        },
        {
          "id": "save",
          "label": "no"
        }
      ]
    },
    {
      "id": "wait",
      "label": "Wait as told, then retry",
      "detail": "Up to four retries",
      "group": "Review spider loop",
      "to": [
        {
          "id": "page",
          "label": "retry"
        }
      ]
    },
    {
      "id": "save",
      "label": "Save reviews, record the page",
      "detail": "Ctrl+C any time, then --resume",
      "group": "Review spider loop"
    },
    {
      "id": "last",
      "label": "Was that the last page?",
      "kind": "decision",
      "group": "Review spider loop",
      "to": [
        {
          "id": "page",
          "label": "no"
        },
        {
          "id": "more",
          "label": "yes"
        }
      ]
    },
    {
      "id": "more",
      "label": "Any titles left?",
      "kind": "decision",
      "group": "Review spider loop",
      "to": [
        {
          "id": "pick",
          "label": "yes"
        },
        {
          "id": "export",
          "label": "no"
        }
      ]
    },
    {
      "id": "export",
      "label": "Export the Kaggle CSV files",
      "kind": "end",
      "detail": "Reviews sorted oldest first"
    }
  ],
  "lessons": [
    "Scrapy 2.16 stopped calling start_requests(), so the 2023 code, freshly installed, exited silently without crawling anything.",
    "MAL's robots.txt now disallows Scrapy and the public Jikan API shut down in October 2026, so the default source moved to Jikan-Edge.",
    "The 2023 export sorted reviews by the date as text, so April came before January."
  ],
  "architecture": [
